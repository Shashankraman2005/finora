# ==============================================================================
# FINORA INTELLIGENCE OS – ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STOCK MARKET REAL-TIME MARKET DATA PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Finora supports genuine market data providers for Indian (NSE/BSE) and global equities.
# Users can also configure their personal API keys directly in Finora -> Profile & Settings.

# Twelve Data API Key (Recommended for Indian Equities - NSE & BSE):
# Register at: https://twelvedata.com (Free tier: 800 req/day, 8 req/min)
VITE_TWELVE_DATA_API_KEY=

# Finnhub Stock API Key (Recommended for US Equities - AAPL, MSFT, GOOGL, NVDA, TSLA):
# Register at: https://finnhub.io (Free tier: 60 req/min)
VITE_FINNHUB_API_KEY=

# Alpha Vantage API Key (Alternative global market quotes):
# Register at: https://www.alphavantage.co (Free tier: 25 req/day)
VITE_ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------------------
# 2. INDIAN MUTUAL FUND DATA (AMFI) - ZERO CONFIGURATION REQUIRED
# ------------------------------------------------------------------------------
# Finora automatically queries the Association of Mutual Funds in India (AMFI)
# through the open public API endpoint at https://api.mfapi.in/mf.
# Covers ~40,000 schemes across HDFC, SBI, ICICI Prudential, Parag Parikh, Axis, etc.
# NO API KEY OR SUBSCRIPTION NEEDED.

# ------------------------------------------------------------------------------
# 3. OFFLINE / BENCHMARK EOD FALLBACK
# ------------------------------------------------------------------------------
# When API keys are omitted or rate-limits are reached, Finora displays genuine
# End-of-Day (EOD) exchange prices with clear "Delayed / EOD" freshness badges.
# Live quotes are never fabricated.
